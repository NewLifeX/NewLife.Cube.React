<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFrameworks>net6.0;net7.0;net8.0;net9.0;net10.0</TargetFrameworks>
    <AssemblyTitle>Cube React Skin</AssemblyTitle>
    <Description>React front-end skin for NewLife.Cube, built with React 19 + Ant Design 6, providing an out-of-the-box admin console. Supports dynamic menus, metadata-driven lists and forms, CRUD, OAuth sign-in and runtime localization.</Description>
    <Company>新生命开发团队</Company>
    <Copyright>©2002-2026 NewLife</Copyright>
    <VersionPrefix>1.0</VersionPrefix>
    <VersionSuffix>$([System.DateTime]::Now.ToString(`yyyy.MMdd`))</VersionSuffix>
    <Version>$(VersionPrefix).$(VersionSuffix)</Version>
    <FileVersion>$(Version)</FileVersion>
    <AssemblyVersion>$(VersionPrefix).*</AssemblyVersion>
    <Deterministic>false</Deterministic>
    <OutputPath>..\Bin</OutputPath>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <SignAssembly>True</SignAssembly>
    <AssemblyOriginatorKeyFile>..\Doc\newlife.snk</AssemblyOriginatorKeyFile>
    <NoWarn>1701;1702;NU5104;NETSDK1138;CS7035</NoWarn>
  </PropertyGroup>
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>NewLife.Cube.React</PackageId>
    <PackageDescription>React front-end skin for NewLife.Cube (React 19 + Ant Design 6), with dynamic menus, metadata-driven lists and forms, CRUD, OAuth sign-in and runtime localization. 魔方 React 前端皮肤：动态菜单、字段元数据驱动的列表与表单、CRUD、OAuth 登录与运行时多语言本地化；引用 NuGet 包即可获得完整前端。</PackageDescription>
    <Authors>$(Company)</Authors>
    <PackageProjectUrl>https://newlifex.com/cube</PackageProjectUrl>
    <PackageIcon>leaf.png</PackageIcon>
    <RepositoryUrl>https://github.com/NewLifeX/NewLife.Cube</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>新生命团队;X组件;NewLife;$(AssemblyName);React;AntDesign</PackageTags>
    <PackageReleaseNotes>魔方React皮肤独立NuGet包，基于React19+Ant Design6+Zustand+Vite；字段元数据驱动通用列表/表单/搜索/详情，零前端开发；工作台仪表盘对齐MVC，KPI卡片拖拽排序即时保存；列表列自定义显隐顺序、双击编辑、导出携带查询条件；角色权限弹窗树形勾选；省市区级联选择与地区地图模式；日志TraceId星尘超链接</PackageReleaseNotes>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="NewLife" />
  </ItemGroup>

  <!-- 引用 ASP.NET Core 共享框架 -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.AspNetCore.Builder" />
    <Using Include="Microsoft.AspNetCore.Hosting" />
    <Using Include="Microsoft.AspNetCore.Http" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.403">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- 将 wwwroot 静态文件嵌入程序集。sourcemap 仅用于本地调试，不随包分发 -->
  <ItemGroup>
    <EmbeddedResource Include="wwwroot\**\*" Exclude="wwwroot\**\*.map" />
  </ItemGroup>

  <!-- 打包前校验前端产物，避免把没有内置前端的空壳包发到 NuGet -->
  <Target Name="VerifySpaAssets" BeforeTargets="GenerateNuspec" Condition="'$(IsPackable)' == 'true'">
    <Error Condition="!Exists('wwwroot\index.html')" Text="wwwroot/index.html not found. Run 'pnpm install &amp;&amp; pnpm build' in NewLife.Cube.React/web before packing." />
  </Target>

  <!-- SelfHost 调试文件统一不作为 None 项（Debug 时为 Content，Release 时完全排除） -->
  <ItemGroup>
    <None Remove="SelfHost\**\*" />
  </ItemGroup>

  <!-- 类库（Release）排除自托管调试代码，保证打包 DLL 干净；Exe（Debug）由默认编译 glob 自动包含 -->
  <ItemGroup Condition="'$(OutputType)' != 'Exe'">
    <Compile Remove="SelfHost\**\*.cs" />
  </ItemGroup>

  <!-- Exe（Debug）时启用自托管配置文件 -->
  <ItemGroup Condition="'$(OutputType)' == 'Exe'">
    <!-- Link 去掉 SelfHost 子目录，保证 appsettings 平铺到输出根目录 -->
    <Content Include="SelfHost\appsettings*.json" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\Doc\leaf.png" Link="leaf.png" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- 多语言基线：Cube 6.15.2026.1022 起内置请求级本地化（UseCubeLocalization），界面元数据按请求语言翻译 -->
    <!-- 6.16.2026.1030 起提供 ICubeSkin/UseCubeSkin，多皮肤包共存时按设置切换 -->
    <PackageReference Include="NewLife.Cube" Version="6.16.2026.1030" />
    <!-- 直接引用 Core：导入 build/NewLife.Core.props，使本包 Locales/*.yml 自动编译进词表 -->
    <PackageReference Include="NewLife.Core" Version="12.0.2026.1024" />
  </ItemGroup>

</Project>
